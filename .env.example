# 托管代理（server/hosted-core.mjs）的环境变量。
#
# 用法：复制成 .env（本地）/ 或在 Vercel、Cloudflare 的控制台里逐条填。
# 这个文件里**没有**任何真实密钥，密钥只在部署平台的环境变量里，永远不会进前端包。
#
# 前端静态站不需要这些变量也能跑（内置演示引擎 + 访客自带 Key 两条路都在）。
# 只有"产品方出钱、访客零配置"的托管模式需要。

# 上游 OpenAI 兼容接口的 base，末尾不要带 /chat/completions
UPSTREAM_BASE_URL=https://api.deepseek.com/v1

# 上游密钥。**必填**，不填的话 /api/health 会如实回 ready:false，
# 前端就不会把「托管模型」这个选项露给访客（而不是让访客点进去收一个 401）。
UPSTREAM_API_KEY=

# 上游模型名。服务端强制使用这个值，客户端传什么 model 都会被丢掉。
UPSTREAM_MODEL=deepseek-chat

# ---- 配额（可选，都有默认值）----
# 单个 IP 每天能用几次
HOSTED_DAILY_PER_IP=20
# 全体访客每天总共能用几次 —— 这条就是每天的账单上限
HOSTED_DAILY_GLOBAL=200
# 单次请求的提示词上限（字符）
HOSTED_MAX_PROMPT_CHARS=60000
# 单次响应的 max_tokens 上限
HOSTED_MAX_TOKENS=8000
# 跨域白名单，默认 *（这个代理本来就是给公开静态站用的）
HOSTED_ALLOWED_ORIGINS=*
# 等上游响应头的超时（毫秒），不是总时长上限
HOSTED_TIMEOUT_MS=120000

# ---- 下面这个是构建期变量，给**前端**用的（注意没有 VITE_ 前缀的都不会进前端）----
# 托管代理部署好之后，如果它和静态站不同源，就在这里指定它的地址；
# 例如 https://forge-hosted.vercel.app（结尾不要带 /）。
# 留空时前端会自动试**同源**的 /api（同一个 Vercel 项目同时托管静态站和代理时正好）。
VITE_HOSTED_BASE_URL=
